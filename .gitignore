### Environment files
# Ignore all .env files and any variants
.env
.env.*
# Local environment overrides
.env.local
.env.development
.env.production

### API keys and secrets
# Generic secret files
*.key
*.pem
*.crt
*.secret
# AWS credentials
.aws/credentials
.aws/config

### Other sensitive files
# Private configuration files
config/*.local
config/*.secret

# IDE/editor specific files (optional but common)
# VS Code
.vscode/
# Python
__pycache__/
*.pyc

# Node
node_modules/

# Build artifacts (optional – already likely ignored)
/dist/
/build/
